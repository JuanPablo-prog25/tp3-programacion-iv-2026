@url=http://localhost:3000

### Login para obtener token
# @name login
POST {{url}}/auth/login
Content-Type: application/json

{
    "email": "juan@gmail.com",
    "password": "Minuscula123"
}

###
@token = {{login.response.body.token}}

### Obtener vehiculos
GET {{url}}/vehiculos
Authorization: Bearer {{token}}


### Consultar por un vehiculo
GET {{url}}/vehiculos/3
Authorization: Bearer {{token}}


### Kilometros de un vehiculo
GET {{url}}/vehiculos/5/kilometros
Authorization: Bearer {{token}}


### Crear vehiculo
POST {{url}}/vehiculos
Content-Type: application/json
{
    "marca": "Ford",
    "modelo": "Focus",
    "patente": "AA200HF",
    "anio": 2016,
    "capacidad_carga": 900
}

### Actualizar vehiculo

PUT {{url}}/vehiculos/2
Content-Type: application/json
Authorization: Bearer {{token}}
{
    "marca": "Ford",
    "modelo": "Ranger XLS",
    "patente": "AB123CD",
    "anio": 2023,
    "capacidad_carga": 1300
}

### Eliminar vehiculo
DELETE {{url}}/vehiculos/3
Authorization: Bearer {{token}}